# Optional environment variables — the editor works without any of these

# Google Maps API key (enables address search)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Dev server port (default: 3000)
# PORT=3000

# Set true only when every non-first-party Scene API client must provide a token.
# PASCAL_SCENE_API_REQUIRE_TOKEN=false
# PASCAL_SCENE_API_TOKEN=replace_with_a_secret

# Firebase web app config (Firebase Console → Project settings → General → Your apps)
# NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Signed desktop runtime builder endpoints. The worker receives the complete
# scene graph and returns a queued build job for the requested platform.
# MMM_MAC_BUILD_ENDPOINT=https://builder.example.com/jobs/macos
# MMM_WINDOWS_BUILD_ENDPOINT=https://builder.example.com/jobs/windows
# MMM_BUILDER_TOKEN=replace-with-a-long-random-secret

# NPC AI 대화 (선택). 비워 두면 NPC는 대본 대화만 해요. 키는 서버에만 두세요 (NEXT_PUBLIC_ 금지).
# 프로토콜: openai = OpenAI 호환 Chat Completions (OpenAI, Gemini, OpenRouter, Vercel AI Gateway, Groq, Ollama, LM Studio), anthropic = Anthropic Messages API
NPC_AI_PROVIDER=
# API 주소. 비우면 openai는 https://api.openai.com/v1, anthropic은 https://api.anthropic.com (예: Ollama는 http://localhost:11434/v1)
NPC_AI_BASE_URL=
# 제공사 API 키. localhost / 127.0.0.1 주소(Ollama, LM Studio)라면 비워도 돼요
NPC_AI_API_KEY=
# 쓸 모델 이름 (필수). 제공사 문서의 모델 이름을 그대로 적어요
NPC_AI_MODEL=
# false로 두면 AI 대화를 바로 끄고 모든 NPC가 대본으로 돌아가요 (비상 스위치)
NPC_AI_ENABLED=
# 장면 하나가 하루(UTC)에 받을 수 있는 AI 답변 수. 비우면 1000
NPC_AI_DAILY_LIMIT=
# AI 답변 서명용 비밀값 (서버 음성이 AI 답변만 읽게 함). 비우면 서버 프로세스마다 새로 만들어요 — 서버가 여러 대면 꼭 설정
NPC_AI_REPLY_SECRET=

# NPC 서버 음성 (선택). 비워 두면 브라우저 음성(무료)으로 말해요. OpenAI 호환 /audio/speech 엔드포인트
# 음성 API 주소. 비우면 https://api.openai.com/v1 (로컬 TTS 서버 주소도 가능)
NPC_TTS_BASE_URL=
# 음성 API 키. localhost / 127.0.0.1 주소라면 비워도 돼요
NPC_TTS_API_KEY=
# 음성 모델 이름. 이 값(과 키 또는 로컬 주소)이 있어야 서버 음성을 써요
NPC_TTS_MODEL=
# 기본 목소리 id. NPC마다 목소리를 따로 고르면 그 값이 우선이에요
NPC_TTS_VOICE=

# AI 실사 사진 (선택). 스튜디오의 3D 캐릭터를 실제 사진처럼 바꿔요. 키는 서버에만 두세요 (NEXT_PUBLIC_ 금지).
# 프로토콜: openai = OpenAI 호환 이미지 편집 API(/images/edits: OpenAI, Azure OpenAI v1, LiteLLM 프록시 등), gemini = Gemini API generateContent(Google AI Studio, Vertex AI express)
AI_PHOTO_PROVIDER=
# API 주소(끝의 / 없이). 비우면 openai는 https://api.openai.com/v1, gemini는 https://generativelanguage.googleapis.com/v1beta
AI_PHOTO_BASE_URL=
# 제공사 API 키. localhost / 127.0.0.1 주소라면 비워도 돼요
AI_PHOTO_API_KEY=
# 이미지 모델 이름 (필수). 제공사 문서의 이름을 그대로 적어요
AI_PHOTO_MODEL=
# 모델별 추가 옵션 JSON (예: openai {"quality":"medium"}, gemini {"imageSize":"1K"}). 핵심·안전 키를 넣거나 JSON이 틀리면 기능이 꺼져요
AI_PHOTO_EXTRA_PARAMS=
# false로 두면 AI 실사 사진을 꺼요 (비상 스위치)
AI_PHOTO_ENABLED=
# 서버 하루(UTC) 전체 사진 수, 비우면 200
AI_PHOTO_DAILY_LIMIT=
# 로그인 사용자 1명당 하루 사진 수, 비우면 10
AI_PHOTO_USER_DAILY_LIMIT=
# true면 로그인하지 않은 방문자도 써요 (IP당 하루 3장). 비우면 로그인 필요
AI_PHOTO_ALLOW_ANONYMOUS=
# true면 올린 얼굴 사진을 참고해 만들어요. 아래 검사 모델을 꼭 함께 설정해야 하고, 성인 캐릭터·로그인 사용자만 써요
AI_PHOTO_FACE_ENABLED=
# OpenAI 호환 /moderations 검사 모델 이름. 설정하면 입력·결과 사진을 검사해요 (얼굴 사진 기능에는 필수)
AI_PHOTO_MODERATION_MODEL=
# 검사 API 주소, 비우면 https://api.openai.com/v1
AI_PHOTO_MODERATION_BASE_URL=
# 검사 API 키. 비우면 검사 주소가 AI_PHOTO_BASE_URL과 같을 때만 AI_PHOTO_API_KEY를 써요
AI_PHOTO_MODERATION_API_KEY=

# AI 인물 (선택). 고른 생김새로 AI가 가상의 성인 인물 사진을 만들고, 그 사진 한 장으로 3D 아바타 서비스(Avatar SDK MetaPerson)가
# 움직이는 실사 아바타를 만들어요. 사진 단계는 위의 AI 실사 사진 설정(AI_PHOTO_PROVIDER/BASE_URL/API_KEY/MODEL, 검사 모델)을 그대로 써요.
# 생김새는 정해진 항목으로만 고르고 자유 입력은 없어요 (실존 인물의 이름·설명을 보낼 수 없음).
# 키는 서버에만 두세요 (NEXT_PUBLIC_ 금지). 확인: bun --env-file=.env.local scripts/photoreal/check-avatar-service.ts
# 진짜 키로 켜면 Firebase 로그인 토큰이 있는 사용자만 쓸 수 있어요 (개발용 로컬 사용자 헤더는 목업에서만 받아요)
# false로 두면 새 AI 인물 만들기를 꺼요 (비상 스위치). 이미 만든 아바타는 계속 보이고, 만들던 것은 끝까지 처리·정리해요.
# 아래 3D 아바타 서비스 키가 없으면 true로 넣어야 켜져요: 그때는 사진 값만 들어요 (AI_PHOTO_API_KEY로 청구).
# 한 명을 만들 때 정면 사진 1장 + 같은 인물의 45°·옆얼굴 사진 4장(아래 AI_AVATAR_VIEWS_*)을 만들어요
AI_AVATAR_ENABLED=
# 인물 사진 생성 추가 옵션 JSON (예: openai {"quality":"high","output_format":"jpeg"}, gemini {"imageSize":"1K"}). WebP·핵심·안전 키를 넣거나 JSON이 틀리면 기능이 꺼져요
AI_AVATAR_PORTRAIT_EXTRA_PARAMS=
# 서버 하루(UTC) 전체 인물 사진 수, 비우면 100. 주의: AI 실사 사진의 AI_PHOTO_DAILY_LIMIT(비우면 200)과 따로 세요.
# 둘 다 같은 AI_PHOTO_API_KEY로 청구되니, 하루 최대 이미지 수는 두 한도를 더한 값이에요 (기본 300장)
AI_AVATAR_PORTRAIT_DAILY_LIMIT=
# 로그인 사용자 1명당 하루 인물 사진 수, 비우면 8
AI_AVATAR_PORTRAIT_USER_DAILY_LIMIT=
# 서비스 없이 브라우저가 만들 때, 인물 사진 한 장의 45°·옆얼굴 사진 묶음(4장)을 서버 하루 전체 몇 묶음까지 만들지, 비우면 25 (100장).
# 이것도 같은 AI_PHOTO_API_KEY로 청구돼요
AI_AVATAR_VIEWS_DAILY_LIMIT=
# 로그인 사용자 1명당 하루 45°·옆얼굴 사진 묶음 수, 비우면 4
AI_AVATAR_VIEWS_USER_DAILY_LIMIT=
# 3D 아바타 서비스(유료, 선택). 아래 Client ID / Secret을 비워 두면 서비스 없이 브라우저가 인물 사진으로
# 아바타를 직접 만들어요 ("이 얼굴로 아바타 만들기", 사진 아바타와 같은 방식). 지금은 metaperson만 있어요 (비우면 metaperson)
AI_AVATAR_SERVICE=
# accounts.avatarsdk.com/developer 에서 만든 앱의 Client ID / Client Secret ("Client credentials" 방식). 하나만 넣거나 주소가 틀리면 기능이 꺼져요
AI_AVATAR_CLIENT_ID=
AI_AVATAR_CLIENT_SECRET=
# 서비스 API 주소, 비우면 https://api.avatarsdk.com
AI_AVATAR_BASE_URL=
# (선택) 서비스의 플레이어 코드. 비우면 처음 쓸 때 하나 등록해 저장소 폴더에 기억해요
AI_AVATAR_PLAYER_UID=
# 서버 하루(UTC) 전체 3D 아바타 수, 비우면 10 (요금제 사용량이 차감돼요). 서비스로 보낸 수를 저장소 폴더에 기록해,
# 실패 환불이나 서버 재시작으로 줄지 않는 진짜 상한이에요
AI_AVATAR_DAILY_LIMIT=
# 로그인 사용자 1명당 하루 3D 아바타 수, 비우면 2 (서비스 쪽 실패는 하루 3번까지 돌려줘요)
AI_AVATAR_USER_DAILY_LIMIT=
# true면 서비스가 model_info에 나이(child / not_child)를 주지 않은 아바타를 버려요. 확인 스크립트 결과에
# "model_info.age = not_child"가 나오는 걸 본 뒤에 켜세요 (안 주는데 켜면 모든 아바타가 거절돼요)
AI_AVATAR_REQUIRE_AGE_CHECK=
# 인물 사진 확인용 서명 비밀값 (긴 무작위 문자열). 비우면 서버 프로세스마다 새로 만들어요 — 서버가 여러 대면 꼭 설정
AI_AVATAR_SECRET=
# 만든 아바타·사진, 진행 중인 작업, 하루 사용량 기록을 저장할 폴더. 비우면 apps/editor/data/photoreal-ai (git에 올라가지 않음)
AI_AVATAR_STORE_DIR=
# true면 외부 API 없이 목업 사진·목업 3D로 흐름만 확인해요 (개발 서버 전용, 배포에서는 무시)
AI_AVATAR_MOCK=
# (목업 전용, 선택) 목업 사진으로 쓸 내 컴퓨터의 JPEG/PNG 경로 (가상 인물 이미지만). 비우면 그림을 그려 써요.
# 같은 폴더에 <이름>-left45, -right45, -left90, -right90 (확장자 같게) 사진을 두면 그 사진들이 45°·옆얼굴 사진이 돼요.
# 없으면 정면 한 장으로 만들어 '옆모습 추정'으로 표시해요
AI_AVATAR_MOCK_PORTRAIT=
# (목업 전용, 선택) 목업 3D로 돌려줄 내 컴퓨터의 GLB 경로. 비우면 저장소의 CC0 실사 캐릭터를 써요
AI_AVATAR_MOCK_GLB=

# --- 사진으로 실사 아바타 (캐릭터 스튜디오 > 실사) ---
# 3D 얼굴 촬영·사진 여러 장·내 사진 한 장으로 실사 아바타를 만들어요. 사진과 사진으로 만든 것은 브라우저 안에서만
# 처리되고 서버로 보내지 않아요 (아바타와 카드 그림은 그 브라우저의 저장소에만 남아요).
# 개발 서버(bun dev)에서는 비워 두면 켜져 있고, 배포(production)에서는 true로 넣어야 켜져요. false면 어디서나 꺼져요.
# 켤 때마다 "성인 본인 또는 동의받은 얼굴" 확인을 받지만, AI 실사 사진의 얼굴 사진 기능과 달리 로그인이나
# 서버의 만 18세·동의 기록은 요구하지 않아요 (서버로 오는 것이 없어 기록을 붙일 곳이 없어요).
# 성인 확인은 사용자의 확인에만 기대니, 계정에 18세 이상 확인이 꼭 있어야 하는 서비스라면 그때까지 배포에서는 켜지 마세요.
# (AI 가상 인물로 만드는 아바타는 이 설정과 상관없이 위의 AI 인물 설정을 따라요)
PHOTO_AVATAR_FACE_ENABLED=
